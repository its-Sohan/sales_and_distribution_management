{
  "name": "masum-it",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-08",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "masum-it-cottage-account-database-main",
      "database_id": "2b3b300a-1176-4210-8150-b9f27c68608e",
      "migrations_dir": "migrations"
    }
  ]
}

{
  "name": "hisab-counter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node scripts/test.mjs",
    "test:pricing-ui": "node scripts/test-sale-pricing-ui.mjs",
    "test:web-ui": "node scripts/test-web-ui.mjs",
    "check:worker": "tsc -p worker/tsconfig.json",
    "db:migrate": "npx wrangler d1 migrations apply mayer-dowa-telecom-database-main --remote",
    "deploy": "npm test && npm run check:worker && npm run build && npm run db:migrate && npx wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply mayer-dowa-telecom-database-main --local",
    "db:seed:local": "wrangler d1 execute mayer-dowa-telecom-database-main --local --file scripts/seed_computer_products.sql"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-bengali": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/hind-siliguri": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "exceljs": "^4.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "wrangler": "^4.149.0"
  }
}
